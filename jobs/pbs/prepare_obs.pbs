#!/usr/bin/env bash
#PBS -N o3d_obs
#PBS -q omp
#PBS -l select=1:ncpus=8:mem=64g
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o logs/
#
# Simulate the observing system. Downloads nothing, so no `ftp` queue needed.
# The three output catalog keys must already be declared in config/paths/<site>.yaml -- that is how
# the simulator knows where to write.
#     qsub -v OCEANML3D_SITE=datarmor jobs/pbs/prepare_obs.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p logs
export OCEANML3D_SITE="${OCEANML3D_SITE:-datarmor}"
export OMP_NUM_THREADS="${NCPUS:-1}"
exec jobs/prepare.sh obs
