#!/usr/bin/env bash
#PBS -N o3d_glorys
#PBS -q omp
#PBS -l select=1:ncpus=8:mem=32g
#PBS -l walltime=03:00:00
#PBS -J 2010-2020
#PBS -j oe
#PBS -o logs/
#
# One year of GLORYS truth per sub-job. Not one monolithic job: that chains thousands of file opens
# on a single core and saves nothing along the way, so one walltime overrun loses everything. A year
# that overruns is relaunched on its own -- `qsub -J 2015-2015 jobs/pbs/prepare_glorys.pbs` -- while
# the others stay done, and regrid.py skips completed outputs so relaunching the whole array is safe.
#
#     qsub -v OCEANML3D_SITE=datarmor jobs/pbs/prepare_glorys.pbs
#
# Adjust the year range with -J on the command line: `qsub -J 2010-2012 ...`.
set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p logs
export OCEANML3D_SITE="${OCEANML3D_SITE:-datarmor}"
export OMP_NUM_THREADS="${NCPUS:-1}"
exec jobs/prepare.sh glorys "${PBS_ARRAY_INDEX:?submit with -J <first>-<last>}"
